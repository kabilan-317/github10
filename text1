<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>English Alphabet</title>
  <style>
    * {
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      margin: 0;
      padding: 48px 20px;
      background: #f1f5f9;
      color: #172554;
      font-family: Arial, sans-serif;
      text-align: center;
    }

    main {
      width: min(100%, 900px);
      margin: 0 auto;
    }

    h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 6vw, 3rem);
    }

    p {
      margin: 0 0 32px;
      color: #475569;
    }

    .alphabet {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: 14px;
    }

    .letter {
      min-height: 112px;
      display: grid;
      place-content: center;
      gap: 5px;
      border: 1px solid #dbeafe;
      border-radius: 16px;
      background: white;
      box-shadow: 0 4px 12px rgba(30, 64, 175, 0.06);
    }

    .uppercase {
      color: #2563eb;
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1;
    }

    .lowercase {
      color: #64748b;
      font-size: 1.25rem;
    }
  </style>
</head>
<body>
  <main>
    <h1>The English Alphabet</h1>
    <p>Explore all 26 letters, in uppercase and lowercase.</p>
    <section class="alphabet" id="alphabet" aria-label="English alphabet"></section>
  </main>

  <script>
    const alphabet = document.getElementById("alphabet");

    for (let code = 65; code <= 90; code += 1) {
      const uppercase = String.fromCharCode(code);
      const card = document.createElement("article");
      card.className = "letter";
      card.setAttribute("aria-label", `${uppercase}, ${uppercase.toLowerCase()}`);
      card.innerHTML = `
        <span class="uppercase">${uppercase}</span>
        <span class="lowercase">${uppercase.toLowerCase()}</span>
      `;
      alphabet.appendChild(card);
    }
  </script>
</body>
</html>

